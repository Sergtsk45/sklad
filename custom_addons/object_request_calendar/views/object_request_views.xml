<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_object_request_form_calendar" model="ir.ui.view">
        <field name="name">object.request.form.calendar</field>
        <field name="model">object.request</field>
        <field name="inherit_id" ref="object_request.view_object_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    icon="fa-calendar"
                    type="object"
                    name="action_open_calendar_events"
                    invisible="calendar_event_count == 0"
                >
                    <field
                        name="calendar_event_count"
                        widget="statinfo"
                        string="Встречи"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
