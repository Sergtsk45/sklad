<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ai_assistant.AiChatWidget">
        <div t-if="state.hasAccess" class="o_ai_assistant_root">

            <!-- Chat panel -->
            <div t-if="state.isOpen" class="o_ai_assistant_panel">

                <!-- Header -->
                <div class="o_ai_assistant_header">
                    <div class="o_ai_assistant_header_left">
                        <span
                            t-attf-class="o_ai_status_dot o_ai_status_{{ state.status }}"
                            t-attf-title="{{ state.status === 'online' ? 'Онлайн' : 'Ошибка подключения' }}"
                        />
                        <span class="o_ai_assistant_title">AI-консультант</span>
                    </div>
                    <div class="o_ai_assistant_header_actions">
                        <button
                            class="o_ai_header_btn"
                            t-on-click="clearSession"
                            title="Очистить диалог"
                        >
                            <i class="fa fa-trash-o"/>
                        </button>
                        <button
                            class="o_ai_header_btn"
                            t-on-click="toggleChat"
                            title="Закрыть"
                        >
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                </div>

                <!-- Body: messages -->
                <div class="o_ai_assistant_body">

                    <!-- Suggested prompts (shown when no messages) -->
                    <div t-if="showSuggested" class="o_ai_suggested_prompts">
                        <p class="o_ai_suggested_label">Попробуйте спросить:</p>
                        <t t-foreach="suggestedPrompts" t-as="prompt" t-key="prompt">
                            <button
                                class="o_ai_suggested_chip"
                                t-on-click="() => this.onSuggestedPrompt(prompt)"
                            >
                                <t t-esc="prompt"/>
                            </button>
                        </t>
                    </div>

                    <!-- Messages list -->
                    <t t-foreach="state.messages" t-as="msg" t-key="msg.timestamp">
                        <div t-attf-class="o_ai_message o_ai_message_{{ msg.role }}">
                            <div class="o_ai_message_bubble">
                                <t t-if="messageDisplayContent(msg)">
                                    <div class="o_ai_message_text">
                                        <t t-esc="messageDisplayContent(msg)"/>
                                    </div>
                                </t>
                                <t t-if="messageLinks(msg).length">
                                    <div class="o_ai_message_links">
                                        <a
                                            t-foreach="messageLinks(msg)"
                                            t-as="link"
                                            t-key="link.url"
                                            class="o_ai_link_btn"
                                            t-att-href="link.url"
                                            t-att-title="link.menu_breadcrumb or link.label"
                                        >
                                            <i class="fa fa-external-link"/>
                                            <span><t t-esc="link.label"/></span>
                                        </a>
                                    </div>
                                </t>
                                <t t-if="msg.cards">
                                    <t t-foreach="msg.cards" t-as="card" t-key="cardKey(card, card_index)">
                                        <ConfirmationCard
                                            t-if="card.type === 'confirmation'"
                                            plan="card.plan"
                                            pendingKey="card.pending_key"
                                            onConfirm.bind="onConfirmPending"
                                            onCancel.bind="onCancelPending"
                                        />
                                        <ResultCard
                                            t-if="card.type === 'result'"
                                            status="card.status"
                                            record="card.record"
                                            error="card.error"
                                            nextHint="card.next_hint"
                                        />
                                    </t>
                                </t>
                            </div>
                        </div>
                    </t>

                    <!-- Loading indicator -->
                    <div t-if="state.isLoading" class="o_ai_message o_ai_message_assistant">
                        <div class="o_ai_message_bubble o_ai_typing">
                            <span/><span/><span/>
                        </div>
                    </div>

                    <!-- Scroll anchor -->
                    <div t-ref="messagesEnd"/>
                </div>

                <!-- Footer -->
                <div class="o_ai_assistant_footer">
                    <textarea
                        t-ref="textarea"
                        class="o_ai_input"
                        placeholder="Напишите вопрос…"
                        rows="1"
                        t-att-value="state.inputText"
                        t-on-input="onInput"
                        t-on-keydown="onInputKeydown"
                        t-att-disabled="state.isLoading"
                    />
                    <button
                        class="o_ai_send_btn"
                        t-on-click="sendMessage"
                        t-att-disabled="!state.inputText.trim() or state.isLoading"
                        title="Отправить"
                    >
                        <i class="fa fa-paper-plane"/>
                    </button>
                </div>
                <div class="o_ai_footer_hint">
                    Ассистент отвечает только по функциям Odoo
                </div>

            </div>

            <!-- FAB button -->
            <button
                t-attf-class="o_ai_assistant_fab {{ state.isOpen ? 'o_ai_fab_active' : '' }}"
                t-on-click="toggleChat"
                title="AI-консультант"
            >
                <i t-attf-class="fa {{ state.isOpen ? 'fa-times' : 'fa-comments' }}"/>
            </button>

        </div>
    </t>

    <t t-name="ai_assistant.ConfirmationCard">
        <div t-attf-class="o_ai_confirmation_card {{ props.plan.state ? 'o_ai_card_' + props.plan.state : '' }}">
            <div class="o_ai_card_title">
                <t t-esc="props.plan.title"/>
            </div>
            <table t-if="props.plan.fields and props.plan.fields.length" class="o_ai_card_fields">
                <tbody>
                    <tr t-foreach="props.plan.fields" t-as="field" t-key="field.label">
                        <th><t t-esc="field.label"/></th>
                        <td><t t-esc="field.value"/></td>
                    </tr>
                </tbody>
            </table>
            <div t-if="props.plan.tool_name" class="o_ai_card_tool">
                <t t-esc="props.plan.tool_name"/>
            </div>
            <div t-if="props.plan.state" class="o_ai_card_status">
                <t t-if="props.plan.state === 'confirmed'">Подтверждено</t>
                <t t-elif="props.plan.state === 'cancelled'">Отменено</t>
            </div>
            <div t-if="!props.plan.state" class="o_ai_card_actions">
                <button
                    class="o_ai_card_btn o_ai_card_btn_secondary"
                    t-on-click="onCancelClick"
                    title="Отменить действие"
                >
                    Отмена
                </button>
                <button
                    class="o_ai_card_btn o_ai_card_btn_primary"
                    t-on-click="onConfirmClick"
                    title="Подтвердить действие"
                >
                    Подтвердить
                </button>
            </div>
        </div>
    </t>

    <t t-name="ai_assistant.ResultCard">
        <div t-attf-class="o_ai_result_card o_ai_result_{{ props.status }}">
            <div class="o_ai_result_header">
                <span class="o_ai_result_icon">
                    <i t-attf-class="fa {{ isSuccess ? 'fa-check-circle' : 'fa-exclamation-circle' }}"/>
                </span>
                <span class="o_ai_result_title">
                    <t t-if="isSuccess">Черновик создан</t>
                    <t t-else="">Действие не выполнено</t>
                </span>
            </div>
            <div t-if="isSuccess and props.record" class="o_ai_result_record">
                <a
                    t-if="recordUrl"
                    t-att-href="recordUrl"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <t t-esc="props.record.name || props.record.id"/>
                </a>
                <span t-if="!recordUrl">
                    <t t-esc="props.record.name || props.record.id"/>
                </span>
                <span t-if="props.record.model" class="o_ai_result_model">
                    <t t-esc="props.record.model"/>
                </span>
            </div>
            <div t-if="!isSuccess" class="o_ai_result_error_message">
                <t t-esc="errorMessage"/>
            </div>
            <div t-if="props.nextHint" class="o_ai_result_hint">
                <t t-esc="props.nextHint"/>
            </div>
        </div>
    </t>
</templates>
