<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Privilege (категория прав AI Assistant) -->
    <record id="res_groups_privilege_ai_assistant" model="res.groups.privilege">
        <field name="name">AI Assistant</field>
        <field name="sequence">100</field>
    </record>

    <!-- AI Assistant User: доступ к чату -->
    <record id="group_ai_assistant_user" model="res.groups">
        <field name="name">Пользователь</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_assistant"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Пользователь имеет доступ к чату AI-ассистента.</field>
    </record>

    <!-- AI Assistant Supply: доступ к actions снабжения + наследует User -->
    <record id="group_ai_assistant_supply" model="res.groups">
        <field name="name">Снабжение</field>
        <field name="sequence">15</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_assistant"/>
        <field name="implied_ids" eval="[
            (4, ref('group_ai_assistant_user')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('stock.group_stock_user'))
        ]"/>
        <field name="comment">
            Пользователь может подтверждать ограниченные actions AI-ассистента
            для снабжения и складских черновиков.
        </field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- AI Assistant Admin: доступ к настройкам + наследует User -->
    <record id="group_ai_assistant_admin" model="res.groups">
        <field name="name">Администратор</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_assistant"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_assistant_user'))]"/>
        <field name="comment">Администратор может настраивать AI-ассистента.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
