<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ai_warehouse_stock" model="ir.actions.server">
        <field name="name">AI: остатки по складу</field>
        <field name="model_id" ref="stock.model_stock_warehouse"/>
        <field name="path">ai-warehouse-stock</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="code">
action = env['stock.warehouse'].action_ai_open_warehouse_stock()
        </field>
    </record>
</odoo>
