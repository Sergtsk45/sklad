<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_assistant_audit_list" model="ir.ui.view">
        <field name="name">ai.assistant.audit.list</field>
        <field name="model">ai_assistant.audit</field>
        <field name="arch" type="xml">
            <list string="AI Assistant Audit" create="0" edit="0" delete="0">
                <field name="created_at"/>
                <field name="user_id"/>
                <field name="tool_name"/>
                <field name="result_status"/>
                <field name="record_ref"/>
            </list>
        </field>
    </record>

    <record id="view_ai_assistant_audit_form" model="ir.ui.view">
        <field name="name">ai.assistant.audit.form</field>
        <field name="model">ai_assistant.audit</field>
        <field name="arch" type="xml">
            <form string="AI Assistant Audit" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="created_at"/>
                        <field name="user_id"/>
                        <field name="tool_name"/>
                        <field name="result_status"/>
                        <field name="record_ref"/>
                    </group>
                    <group>
                        <field name="args_summary" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_assistant_audit" model="ir.actions.act_window">
        <field name="name">AI Assistant Audit</field>
        <field name="res_model">ai_assistant.audit</field>
        <field name="view_mode">list,form</field>
        <field name="limit">100</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <menuitem
        id="menu_ai_assistant_root"
        name="AI Assistant"
        parent="base.menu_administration"
        sequence="90"
        groups="ai_assistant.group_ai_assistant_admin"
    />
    <menuitem
        id="menu_ai_assistant_audit"
        name="Audit"
        parent="menu_ai_assistant_root"
        action="action_ai_assistant_audit"
        sequence="10"
        groups="ai_assistant.group_ai_assistant_admin"
    />
</odoo>
