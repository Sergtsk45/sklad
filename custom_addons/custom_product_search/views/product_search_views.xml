<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Товар» in list search also matches by search tokens (UPG-*). -->
    <record id="product_template_search_view_smart" model="ir.ui.view">
        <field name="name">product.template.search.smart</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', '|', ('default_code', 'ilike', self), ('product_variant_ids.default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self), ('x_smart_search', 'ilike', self)]</attribute>
            </field>
        </field>
    </record>

    <record id="product_search_form_view_smart" model="ir.ui.view">
        <field name="name">product.product.search.smart</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', ('default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self), ('x_smart_search', 'ilike', self)]</attribute>
            </field>
        </field>
    </record>
</odoo>
