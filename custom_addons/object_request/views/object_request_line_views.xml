<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         SEARCH VIEW для строк (используется в smart-button «Проблемные строки»)
         ================================================================ -->
    <record id="view_object_request_line_search" model="ir.ui.view">
        <field name="name">object.request.line.search</field>
        <field name="model">object.request.line</field>
        <field name="arch" type="xml">
            <search string="Строки требований">
                <field name="name_raw" string="Наименование"/>
                <field name="supplier_article" string="Артикул поставщика"/>
                <field name="technical_designation" string="Обозначение"/>
                <field name="product_id" string="Товар"/>
                <field name="request_id" string="Документ"/>
                <filter
                    name="filter_matching_required"
                    string="Требует сопоставления"
                    domain="[('matching_required', '=', True)]"
                />
                <filter
                    name="filter_vendor_required"
                    string="Требует поставщика"
                    domain="[('manual_vendor_required', '=', True)]"
                />
                <filter
                    name="filter_stock_match_warning"
                    string="Есть похожий товар на складе"
                    domain="[('stock_match_warning', '=', True)]"
                />
                <filter
                    name="filter_problem"
                    string="Только проблемные"
                    domain="['|', '|',
                        ('matching_required', '=', True),
                        ('manual_vendor_required', '=', True),
                        ('stock_match_warning', '=', True)]"
                />
                <separator/>
                <filter
                    name="filter_partially_issued"
                    string="Частично обеспечено"
                    domain="[('line_state', '=', 'partially_issued')]"
                />
                <filter
                    name="filter_fully_supplied"
                    string="Полностью обеспечено"
                    domain="[('line_state', '=', 'fully_supplied')]"
                />
                <separator/>
                <filter
                    name="group_request"
                    string="Документ"
                    context="{'group_by': 'request_id'}"
                />
                <filter
                    name="group_product"
                    string="Товар"
                    context="{'group_by': 'product_id'}"
                />
                <filter
                    name="group_line_state"
                    string="Статус строки"
                    context="{'group_by': 'line_state'}"
                />
            </search>
        </field>
    </record>

    <!-- ================================================================
         LIST VIEW для строк (автономный — для smart-button «Строки»)
         ================================================================ -->
    <record id="view_object_request_line_list" model="ir.ui.view">
        <field name="name">object.request.line.list</field>
        <field name="model">object.request.line</field>
        <field name="arch" type="xml">
            <list
                string="Строки требования"
                decoration-danger="matching_required == True"
                decoration-warning="stock_match_warning == True or (manual_vendor_required == True and matching_required == False) or line_state == 'partially_issued'"
                decoration-success="line_state == 'fully_supplied'"
                create="0"
                delete="0"
            >
                <field name="request_id" string="Документ" optional="show"/>
                <field name="sequence" string="№"/>
                <field name="name_raw" string="Наименование (файл)"/>
                <field name="supplier_article" string="Артикул" optional="show"/>
                <field
                    name="technical_designation"
                    string="Обозначение"
                    optional="show"
                />
                <field name="company_id" invisible="1"/>
                <field name="preferred_vendor_id" string="Поставщик" optional="show"/>
                <field
                    name="product_id"
                    string="Товар"
                    context="{
                        'display_default_code': True,
                        'object_request_preferred_vendor_id': preferred_vendor_id,
                        'object_request_company_id': company_id,
                    }"
                />
                <field name="uom_id" string="Ед. изм." optional="show"/>
                <field name="capture_id" string="Захватка" optional="show"/>
                <field name="floor_id" string="Этаж" optional="show"/>
                <field name="section_id" string="Участок" optional="show"/>
                <field name="zone" string="Захватка (старое)" optional="hide"/>
                <field name="floor" string="Этаж (старое)" optional="hide"/>
                <field name="section" string="Участок (старое)" optional="hide"/>
                <field name="qty_requested" string="Запрошено"/>
                <field name="qty_to_issue" string="К выдаче (план)" optional="show"/>
                <field name="qty_to_buy" string="К закупке (план)" optional="show"/>
                <field name="qty_issued" string="Обеспечено" optional="show"/>
                <field name="qty_issued_from_stock" string="Со склада" optional="hide"/>
                <field name="qty_received_purchase" string="Поступило по закупке" optional="hide"/>
                <field name="qty_reserved" string="Зарезервировано" optional="show"/>
                <field
                    name="stock_match_candidate_id"
                    string="Складской кандидат"
                    optional="show"
                />
                <field
                    name="stock_match_candidate_qty"
                    string="Остаток кандидата"
                    optional="show"
                />
                <field
                    name="stock_match_warning_text"
                    string="Предупреждение"
                    optional="show"
                />
                <field
                    name="substitute_product_id"
                    string="Разрешённый аналог"
                    optional="show"
                />
                <field
                    name="substitute_stock_qty"
                    string="Остаток аналога"
                    optional="show"
                />
                <field
                    name="substitute_stock_warehouse_names"
                    string="Склады аналога"
                    optional="hide"
                />
                <field
                    name="substitute_warning_text"
                    string="Предупреждение по аналогу"
                    optional="hide"
                />
                <field name="substitute_rule_id" string="Правило аналога" optional="hide"/>
                <field name="matching_source" string="Источник" optional="hide"/>
                <field
                    name="ai_suggested_product_id"
                    string="AI-кандидат"
                    optional="show"
                />
                <field
                    name="ai_match_confidence"
                    string="AI confidence"
                    optional="hide"
                />
                <field
                    name="ai_match_reason"
                    string="AI пояснение"
                    optional="hide"
                />
                <field
                    name="ai_candidate_product_ids"
                    string="AI shortlist"
                    widget="many2many_tags"
                    optional="show"
                />
                <field
                    name="line_state"
                    string="Статус"
                    widget="badge"
                    decoration-danger="line_state == 'requires_mapping'"
                    decoration-warning="line_state == 'partially_issued'"
                    decoration-success="line_state == 'fully_supplied'"
                />
                <field name="matching_required" column_invisible="1"/>
                <field name="manual_vendor_required" column_invisible="1"/>
                <field name="stock_match_warning" column_invisible="1"/>
                <button
                    name="action_accept_ai_candidate"
                    string="Принять AI"
                    type="object"
                    groups="object_request.group_supply_manager"
                    invisible="not ai_suggested_product_id or not matching_required"
                />
                <button
                    name="action_reject_ai_candidate"
                    string="Отклонить AI"
                    type="object"
                    groups="object_request.group_supply_manager"
                    invisible="not ai_suggested_product_id or not matching_required"
                />
                <button
                    name="action_accept_and_remember_ai_candidate"
                    string="Принять и запомнить"
                    type="object"
                    groups="object_request.group_supply_manager"
                    invisible="not ai_suggested_product_id or not matching_required"
                />
                <button
                    name="action_remember_matching"
                    string="Запомнить"
                    type="object"
                    groups="object_request.group_supply_manager"
                    invisible="not product_id"
                />
                <button
                    name="action_refresh_stock_match_warning"
                    string="Проверить складской кандидат"
                    type="object"
                    groups="object_request.group_supply_manager"
                    invisible="not product_id"
                />
                <button
                    name="action_select_stock_match_candidate"
                    string="Выбрать кандидата"
                    type="object"
                    groups="object_request.group_supply_manager"
                    invisible="not stock_match_candidate_id or substitute_rule_id"
                />
                <button
                    name="action_use_substitute_product"
                    string="Использовать аналог"
                    type="object"
                    groups="object_request.group_supply_manager"
                    invisible="not substitute_rule_id"
                />
            </list>
        </field>
    </record>

    <!-- ================================================================
         ACTION для открытия строк конкретного документа
         (используется в smart-button «Строки»)
         ================================================================ -->
    <record id="action_object_request_line" model="ir.actions.act_window">
        <field name="name">Строки требования</field>
        <field name="res_model">object.request.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_object_request_line_search"/>
    </record>

    <record id="view_object_request_line_stock_search" model="ir.ui.view">
        <field name="name">object.request.line.stock.search</field>
        <field name="model">object.request.line.stock</field>
        <field name="arch" type="xml">
            <search string="Распределение по складам">
                <field name="line_id"/>
                <field name="warehouse_id"/>
                <filter
                    name="filter_has_stock"
                    string="Есть остаток"
                    domain="[('qty_on_hand', '>', 0)]"
                />
                <filter
                    name="filter_to_issue"
                    string="К выдаче (план)"
                    domain="[('qty_to_issue', '>', 0)]"
                />
                <filter
                    name="filter_hide_zero"
                    string="Скрыть нулевые"
                    domain="['|', ('qty_on_hand', '>', 0), ('qty_to_issue', '>', 0)]"
                />
                <group>
                    <filter
                        name="group_warehouse"
                        string="Склад"
                        context="{'group_by': 'warehouse_id'}"
                    />
                    <filter
                        name="group_line"
                        string="Строка"
                        context="{'group_by': 'line_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="view_object_request_line_stock_list" model="ir.ui.view">
        <field name="name">object.request.line.stock.list</field>
        <field name="model">object.request.line.stock</field>
        <field name="arch" type="xml">
            <list string="Распределение по складам" editable="bottom">
                <field name="line_id"/>
                <field name="warehouse_id"/>
                <field name="qty_on_hand" readonly="1"/>
                <field name="qty_to_issue"/>
                <field name="qty_reserved" readonly="1"/>
                <field name="last_check_date" readonly="1"/>
                <field name="picking_id" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_object_request_line_stock" model="ir.actions.act_window">
        <field name="name">Распределение по складам</field>
        <field name="res_model">object.request.line.stock</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_object_request_line_stock_search"/>
        <field name="context">{'search_default_filter_hide_zero': 1}</field>
    </record>

    <record id="server_action_object_request_line_buy_all" model="ir.actions.server">
        <field name="name">Закупить всё</field>
        <field name="model_id" ref="model_object_request_line"/>
        <field name="binding_model_id" ref="model_object_request_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_buy_all()</field>
    </record>

    <record id="server_action_object_request_line_issue_max" model="ir.actions.server">
        <field name="name">Выдать максимум</field>
        <field name="model_id" ref="model_object_request_line"/>
        <field name="binding_model_id" ref="model_object_request_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_issue_max()</field>
    </record>

    <record id="server_action_object_request_line_reset_split" model="ir.actions.server">
        <field name="name">Сбросить разбивку</field>
        <field name="model_id" ref="model_object_request_line"/>
        <field name="binding_model_id" ref="model_object_request_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_reset_split()</field>
    </record>

    <record id="server_action_object_request_line_remember_matching" model="ir.actions.server">
        <field name="name">Запомнить сопоставление</field>
        <field name="model_id" ref="model_object_request_line"/>
        <field name="binding_model_id" ref="model_object_request_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_remember_matching()</field>
    </record>

    <record id="server_action_object_request_line_refresh_stock_match" model="ir.actions.server">
        <field name="name">Проверить складские аналоги</field>
        <field name="model_id" ref="model_object_request_line"/>
        <field name="binding_model_id" ref="model_object_request_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_refresh_stock_match_warning()</field>
    </record>

    <record id="server_action_object_request_line_recompute_supply_state" model="ir.actions.server">
        <field name="name">Пересчитать обеспечение</field>
        <field name="model_id" ref="model_object_request_line"/>
        <field name="binding_model_id" ref="model_object_request_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_recompute_supply_state()</field>
    </record>

</odoo>
