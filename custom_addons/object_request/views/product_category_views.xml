<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Основной поставщик категории для строк требований (UPG-005). -->
    <record id="product_category_form_view_or_main_vendor" model="ir.ui.view">
        <field name="name">product.category.form.or.main.vendor</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="or_main_vendor_id"
                       groups="object_request.group_supply_manager"/>
            </field>
        </field>
    </record>
</odoo>
