<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         SEARCH VIEW
         ================================================================ -->
    <record id="view_object_request_search" model="ir.ui.view">
        <field name="name">object.request.search</field>
        <field name="model">object.request</field>
        <field name="arch" type="xml">
            <search string="Требования на комплектацию">

                <!-- Поиск по умолчанию -->
                <field name="name" string="Номер документа"/>
                <field name="project_id" string="Объект"/>
                <field name="foreman_user_id" string="Прораб"/>

                <!-- Фильтры -->
                <filter
                    name="filter_my"
                    string="Мои"
                    domain="['|',
                        ('foreman_user_id', '=', uid),
                        ('buyer_user_id', '=', uid)]"
                />
                <separator/>
                <filter
                    name="filter_draft"
                    string="Черновик"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_in_progress"
                    string="В работе"
                    domain="[('state', '=', 'in_progress')]"
                />
                <filter
                    name="filter_closed"
                    string="Закрыто"
                    domain="[('state', '=', 'closed')]"
                />
                <filter
                    name="filter_cancelled"
                    string="Отменено"
                    domain="[('state', '=', 'cancelled')]"
                />
                <separator/>
                <filter
                    name="filter_has_unmatched"
                    string="Есть несопоставленные строки"
                    domain="[('matching_state', '!=', 'all_matched')]"
                />
                <filter
                    name="filter_needs_vendor"
                    string="Требуют поставщика"
                    domain="[('line_ids.manual_vendor_required', '=', True)]"
                />

                <!-- Группировка -->
                <separator/>
                <filter
                    name="group_project"
                    string="Объект"
                    context="{'group_by': 'project_id'}"
                />
                <filter
                    name="group_foreman"
                    string="Прораб"
                    context="{'group_by': 'foreman_user_id'}"
                />
                <filter
                    name="group_state"
                    string="Статус"
                    context="{'group_by': 'state'}"
                />
                <filter
                    name="group_priority"
                    string="Приоритет"
                    context="{'group_by': 'priority'}"
                />
                <filter
                    name="group_need_date"
                    string="Дата потребности"
                    context="{'group_by': 'need_date'}"
                />

            </search>
        </field>
    </record>

    <!-- ================================================================
         LIST (TREE) VIEW
         ================================================================ -->
    <record id="view_object_request_list" model="ir.ui.view">
        <field name="name">object.request.list</field>
        <field name="model">object.request</field>
        <field name="arch" type="xml">
            <list
                string="Требования на комплектацию"
                decoration-danger="matching_state == 'requires_mapping'"
                decoration-warning="matching_state == 'partial'"
                decoration-muted="state in ('closed', 'cancelled')"
            >
                <field name="name" string="Номер" optional="show"/>
                <field name="project_id" string="Объект" optional="show"/>
                <field name="foreman_user_id" string="Прораб" optional="show"/>
                <field name="need_date" string="Дата потребности" optional="show"/>
                <field name="priority" string="Приоритет" optional="show"/>
                <field name="state" string="Статус" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-primary="state == 'in_progress'"
                    decoration-success="state == 'closed'"
                    decoration-danger="state == 'cancelled'"
                    optional="show"
                />
                <field name="line_count" string="Строк" optional="show"/>
                <field name="line_problem_count" string="Несопоставленных"
                    decoration-danger="line_problem_count &gt; 0"
                    optional="show"
                />
                <field name="matching_state" column_invisible="1"/>
                <field name="create_date" string="Дата создания" optional="hide"/>
                <field name="buyer_user_id" string="Снабженец" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         FORM VIEW
         ================================================================ -->
    <record id="view_object_request_form" model="ir.ui.view">
        <field name="name">object.request.form</field>
        <field name="model">object.request</field>
        <field name="arch" type="xml">
            <form string="Требование на комплектацию" class="o_object_request_full_width_form">

                <!-- HEADER: кнопки действий + statusbar -->
                <header>
                    <button
                        name="action_submit_for_approval"
                        string="На согласование"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'draft' or approval_state not in ('not_required', 'rejected') or not approver_user_id"
                        groups="object_request.group_foreman,object_request.group_supply_manager"
                        title="Отправить документ на согласование указанному согласующему"
                    />
                    <button
                        name="action_approve"
                        string="Согласовать"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft' or approval_state != 'pending'"
                        groups="object_request.group_approver"
                    />
                    <button
                        name="action_reject"
                        string="Отклонить"
                        type="object"
                        class="btn-danger"
                        invisible="state != 'draft' or approval_state != 'pending'"
                        groups="object_request.group_approver"
                        confirm="Вы уверены, что хотите отклонить документ?"
                    />
                    <button
                        name="action_in_progress"
                        string="В работу"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft' or approval_state in ('pending', 'rejected')"
                        groups="object_request.group_foreman,object_request.group_supply_manager"
                    />
                    <button
                        name="action_close"
                        string="Закрыть"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'in_progress'"
                        groups="object_request.group_supply_manager"
                    />
                    <button
                        name="action_cancel"
                        string="Отменить"
                        type="object"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'in_progress')"
                        groups="object_request.group_supply_manager"
                        confirm="Вы уверены, что хотите отменить документ? Это действие необратимо."
                    />
                    <button
                        name="action_open_issue_wizard"
                        string="Создать выдачу"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'in_progress' or line_to_issue_count == 0"
                        groups="object_request.group_supply_manager"
                        title="Создать складской документ выдачи по строкам с заполненным количеством"
                    />
                    <button
                        name="%(object_request.action_report_object_request)d"
                        string="Распечатать требование"
                        type="action"
                        class="btn-secondary"
                        invisible="state == 'cancelled'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,in_progress,closed"
                    />
                </header>

                <sheet>

                    <!-- SMART BUTTONS -->
                    <div class="oe_button_box" name="button_box">

                        <!-- Строки -->
                        <button
                            class="oe_stat_button"
                            icon="fa-list"
                            type="object"
                            name="action_open_lines"
                            invisible="line_count == 0"
                        >
                            <field
                                name="line_count"
                                widget="statinfo"
                                string="Строк"
                            />
                        </button>

                        <!-- Проблемные строки -->
                        <button
                            class="oe_stat_button"
                            icon="fa-exclamation-triangle"
                            type="object"
                            name="action_open_problem_lines"
                            invisible="line_problem_count == 0"
                        >
                            <field
                                name="line_problem_count"
                                widget="statinfo"
                                string="Проблем"
                            />
                        </button>

                        <!-- Выдачи -->
                        <button
                            class="oe_stat_button"
                            icon="fa-truck"
                            type="object"
                            name="action_open_issue_pickings"
                            invisible="issue_picking_count == 0"
                        >
                            <field
                                name="issue_picking_count"
                                widget="statinfo"
                                string="Выдачи"
                            />
                        </button>

                        <!-- Закупки -->
                        <button
                            class="oe_stat_button"
                            icon="fa-shopping-cart"
                            type="object"
                            name="action_open_purchase_orders"
                            invisible="purchase_order_count == 0"
                        >
                            <field
                                name="purchase_order_count"
                                widget="statinfo"
                                string="Закупки"
                            />
                        </button>

                        <button
                            class="oe_stat_button"
                            icon="fa-search"
                            type="object"
                            name="action_check_purchase_stock_matches"
                            invisible="purchase_order_count == 0"
                            groups="object_request.group_supply_manager"
                        >
                            <field
                                name="purchase_order_count"
                                widget="statinfo"
                                string="Диагностика PO"
                            />
                        </button>

                    </div>

                    <!-- Заголовок: номер документа -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- ШАПКА ДОКУМЕНТА -->
                    <group col="3">
                        <group string="Основные данные">
                            <field
                                name="project_id"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="foreman_user_id"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="need_date"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="priority"
                                readonly="state != 'draft'"
                            />
                            <!-- складовые поля убраны на уровне шапки -->
                        </group>
                        <group string="Ответственные">
                            <field name="buyer_user_id"/>
                            <field name="warehouse_user_id"/>
                            <field
                                name="approver_user_id"
                                readonly="state in ('closed', 'cancelled')"
                            />
                            <field
                                name="approval_state"
                                widget="badge"
                                decoration-info="approval_state == 'not_required'"
                                decoration-warning="approval_state == 'pending'"
                                decoration-success="approval_state == 'approved'"
                                decoration-danger="approval_state == 'rejected'"
                                readonly="1"
                            />
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Статистика строк">
                            <field name="line_count" string="Всего строк" readonly="1"/>
                            <field name="line_matched_count" string="Сопоставлено" readonly="1"/>
                            <field name="line_problem_count" string="Проблемных" readonly="1"/>
                            <field name="line_to_issue_count" string="К выдаче" readonly="1"/>
                            <field name="line_to_buy_count" string="К закупке" readonly="1"/>
                            <field
                                name="line_fully_supplied_count"
                                string="Полностью обеспечено"
                                readonly="1"
                            />
                            <field
                                name="matching_state"
                                string="Статус сопоставления"
                                widget="badge"
                                decoration-success="matching_state == 'all_matched'"
                                decoration-warning="matching_state == 'partial'"
                                decoration-danger="matching_state == 'requires_mapping'"
                                readonly="1"
                            />
                        </group>
                    </group>

                    <group>
                        <field
                            name="comment"
                            placeholder="Комментарий к документу..."
                            readonly="state in ('closed', 'cancelled')"
                        />
                    </group>

                    <!-- NOTEBOOK: вкладки -->
                    <notebook>

                        <!-- Вкладка: Строки -->
                        <page string="Строки" name="page_lines">
                            <group groups="object_request.group_supply_manager">
                                <div>
                                    <button
                                        name="action_sort_lines_by_location"
                                        string="Отсортировать строки"
                                        type="object"
                                        class="btn-secondary"
                                    />
                                    <button
                                        name="action_refresh_stock_match_warnings"
                                        string="Проверить номенклатуру"
                                        type="object"
                                        class="btn-secondary ms-2"
                                        groups="object_request.group_supply_manager"
                                    />
                                    <button
                                        string="Рассчитать наличие"
                                        type="object"
                                        name="action_check_stock"
                                        class="btn-secondary ms-2"
                                        invisible="state not in ('draft', 'in_progress')"
                                        title="Запросить физический остаток по складу для каждой строки с товаром"
                                        groups="object_request.group_supply_manager"
                                    />
                                    <button
                                        string="Авто-разбивка"
                                        type="object"
                                        name="action_auto_split"
                                        class="btn-secondary ms-2"
                                        invisible="state not in ('draft', 'in_progress')"
                                        title="Разбить строки на «К выдаче» и «К закупке» по остатку на складе"
                                        groups="object_request.group_supply_manager"
                                    />
                                    <button
                                        string="Подготовить закупку"
                                        type="object"
                                        name="action_open_purchase_wizard"
                                        class="btn-secondary ms-2"
                                        invisible="state not in ('draft', 'in_progress')"
                                        title="Создать черновики закупок по строкам с количеством к закупке"
                                        groups="object_request.group_supply_manager"
                                    />
                                </div>
                            </group>
                            <field
                                name="line_ids"
                                class="o_object_request_line_ids"
                                readonly="1"
                                context="{'object_request_column_layout_scope': 'request_form_lines'}"
                                groups="object_request.group_foreman"
                            >
                                <list
                                    decoration-danger="matching_required == True"
                                    decoration-warning="(manual_vendor_required == True and matching_required == False) or line_state == 'partially_issued'"
                                    decoration-success="line_state == 'fully_supplied'"
                                    create="0"
                                    delete="0"
                                >
                                    <field name="sequence" string="№"/>
                                    <field name="name_raw" string="Наименование (файл)"/>
                                    <field name="product_id" string="Товар"/>
                                    <field name="capture_id" string="Захватка" optional="show"/>
                                    <field name="floor_id" string="Этаж" optional="show"/>
                                    <field name="section_id" string="Участок" optional="show"/>
                                    <field
                                        name="technical_designation"
                                        string="Обозначение"
                                        optional="hide"
                                    />
                                    <field name="uom_id" string="Ед. изм." optional="show"/>
                                    <field name="qty_requested" string="Запрошено"/>
                                    <field name="qty_to_issue" string="К выдаче (план)"/>
                                    <field name="qty_to_buy" string="К закупке (план)"/>
                                    <field name="qty_issued" string="Обеспечено"/>
                                    <field name="qty_issued_from_stock" string="Со склада" optional="hide"/>
                                    <field name="qty_received_purchase" string="Поступило по закупке" optional="hide"/>
                                    <field name="stock_qty_on_hand" string="Остаток" optional="show"/>
                                    <field
                                        name="line_state"
                                        string="Статус строки"
                                        widget="badge"
                                        decoration-danger="line_state == 'requires_mapping'"
                                        decoration-warning="line_state == 'partially_issued'"
                                        decoration-success="line_state == 'fully_supplied'"
                                    />
                                    <field name="matching_required" column_invisible="1"/>
                                    <field name="manual_vendor_required" column_invisible="1"/>
                                </list>
                            </field>
                            <field
                                name="line_ids"
                                class="o_object_request_line_ids"
                                readonly="state in ('closed', 'cancelled')"
                                context="{
                                    'default_request_id': id,
                                    'object_request_column_layout_scope': 'request_form_lines',
                                }"
                                groups="object_request.group_supply_manager,object_request.group_storekeeper"
                            >
                                <list
                                    editable="bottom"
                                    decoration-danger="matching_required == True"
                                    decoration-warning="stock_match_warning == True or (manual_vendor_required == True and matching_required == False) or line_state == 'partially_issued'"
                                    decoration-success="line_state == 'fully_supplied'"
                                >
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_row_no" string="Excel №" optional="hide"/>
                                    <!-- Оригинальные данные из файла → поле выбора (Наименование) -->
                                    <field name="name_raw" string="Наименование (файл)" optional="show"/>
                                    <field name="supplier_article" string="Артикул" optional="show"/>
                                    <field
                                        name="technical_designation"
                                        string="Обозначение"
                                        optional="show"
                                    />
                                    <!-- Поставщик до Товара: при выборе сужает поиск номенклатуры -->
                                    <field name="supplier_raw" string="Поставщик (файл)" optional="show"/>
                                    <field name="preferred_vendor_id" string="Поставщик" optional="show"/>
                                    <field
                                        name="product_id"
                                        string="Товар"
                                        optional="show"
                                        context="{
                                            'display_default_code': True,
                                            'object_request_preferred_vendor_id': preferred_vendor_id,
                                            'object_request_company_id': parent.company_id,
                                        }"
                                    />
                                    <!-- Ед. изм. из файла → выбранная ед. изм. -->
                                    <field name="uom_raw" string="Ед. изм. (файл)" optional="show"/>
                                    <field name="uom_id" string="Ед. изм." optional="show"/>
                                    <!-- Размещение -->
                                    <field name="capture_id" string="Захватка" optional="show"/>
                                    <field name="floor_id" string="Этаж" optional="show"/>
                                    <field name="section_id" string="Участок" optional="show"/>
                                    <field name="zone" string="Захватка (старое)" optional="hide"/>
                                    <field name="floor" string="Этаж (старое)" optional="hide"/>
                                    <field name="section" string="Участок (старое)" optional="hide"/>
                                    <!-- Количества -->
                                    <field name="qty_requested" string="Запрошено" optional="show"/>
                                    <field
                                        name="qty_to_issue"
                                        string="К выдаче (план)"
                                        optional="show"
                                        readonly="parent.state != 'in_progress'"
                                    />
                                    <field
                                        name="qty_to_buy"
                                        string="К закупке (план)"
                                        optional="show"
                                        readonly="parent.state != 'in_progress'"
                                    />
                                    <field name="qty_issued" string="Обеспечено" optional="show" readonly="1"/>
                                    <field name="qty_issued_from_stock" string="Со склада" optional="hide" readonly="1"/>
                                    <field name="qty_received_purchase" string="Поступило по закупке" optional="hide" readonly="1"/>
                                    <field name="qty_reserved" string="Зарезервировано" optional="show" readonly="1"/>
                                    <!-- Физический остаток (Этап 2) -->
                                    <field
                                        name="stock_qty_on_hand"
                                        string="Остаток (склад)"
                                        optional="hide"
                                        readonly="1"
                                        title="Сумма остатков по всем складам проверки (обновляется кнопкой «Рассчитать наличие»)"
                                    />
                                    <field
                                        name="stock_match_candidate_id"
                                        string="Складской кандидат"
                                        optional="show"
                                    />
                                    <field
                                        name="stock_match_candidate_qty"
                                        string="Остаток кандидата"
                                        optional="show"
                                    />
                                    <field
                                        name="stock_match_warning_text"
                                        string="Предупреждение"
                                        optional="show"
                                    />
                                    <!-- Допустимые замены -->
                                    <field
                                        name="allowed_substitute_ids"
                                        string="Замены"
                                        widget="many2many_tags"
                                        optional="hide"
                                    />
                                    <field
                                        name="substitute_product_id"
                                        string="Разрешённый аналог"
                                        optional="show"
                                    />
                                    <field
                                        name="substitute_stock_qty"
                                        string="Остаток аналога"
                                        optional="show"
                                    />
                                    <field
                                        name="substitute_stock_warehouse_names"
                                        string="Склады аналога"
                                        optional="hide"
                                    />
                                    <field
                                        name="substitute_warning_text"
                                        string="Предупреждение по аналогу"
                                        optional="hide"
                                    />
                                    <field name="substitute_rule_id" string="Правило аналога" optional="hide"/>
                                    <!-- Примечание по сопоставлению -->
                                    <field name="matching_note" string="Примечание" optional="hide"/>
                                    <field
                                        name="matching_source"
                                        string="Источник"
                                        optional="hide"
                                    />
                                    <field
                                        name="ai_suggested_product_id"
                                        string="AI-кандидат"
                                        optional="show"
                                    />
                                    <field
                                        name="ai_match_confidence"
                                        string="AI confidence"
                                        optional="hide"
                                    />
                                    <field
                                        name="ai_match_reason"
                                        string="AI пояснение"
                                        optional="hide"
                                    />
                                    <field
                                        name="ai_candidate_product_ids"
                                        string="AI shortlist"
                                        widget="many2many_tags"
                                        optional="show"
                                    />
                                    <field
                                        name="line_state"
                                        string="Статус строки"
                                        widget="badge"
                                        decoration-danger="line_state == 'requires_mapping'"
                                        decoration-warning="line_state == 'partially_issued'"
                                        decoration-success="line_state == 'fully_supplied'"
                                        optional="show"
                                    />
                                    <field name="matching_required" column_invisible="1"/>
                                    <field name="manual_vendor_required" column_invisible="1"/>
                                    <field name="stock_match_warning" column_invisible="1"/>
                                    <field name="comment" string="Комментарий" optional="hide"/>
                                    <button
                                        name="action_accept_ai_candidate"
                                        string="Принять AI"
                                        type="object"
                                        groups="object_request.group_supply_manager"
                                        invisible="not ai_suggested_product_id or not matching_required"
                                    />
                                    <button
                                        name="action_reject_ai_candidate"
                                        string="Отклонить AI"
                                        type="object"
                                        groups="object_request.group_supply_manager"
                                        invisible="not ai_suggested_product_id or not matching_required"
                                    />
                                    <button
                                        name="action_accept_and_remember_ai_candidate"
                                        string="Принять и запомнить"
                                        type="object"
                                        groups="object_request.group_supply_manager"
                                        invisible="not ai_suggested_product_id or not matching_required"
                                    />
                                    <button
                                        name="action_remember_matching"
                                        string="Запомнить"
                                        type="object"
                                        groups="object_request.group_supply_manager"
                                        invisible="not product_id"
                                    />
                                    <button
                                        name="action_refresh_stock_match_warning"
                                        string="Проверить складской кандидат"
                                        type="object"
                                        groups="object_request.group_supply_manager"
                                        invisible="not product_id"
                                    />
                                    <button
                                        name="action_select_stock_match_candidate"
                                        string="Выбрать кандидата"
                                        type="object"
                                        groups="object_request.group_supply_manager"
                                        invisible="not stock_match_candidate_id or substitute_rule_id"
                                    />
                                    <button
                                        name="action_use_substitute_product"
                                        string="Использовать аналог"
                                        type="object"
                                        groups="object_request.group_supply_manager"
                                        invisible="not substitute_rule_id"
                                    />
                                </list>
                            </field>
                        </page>

                        <page
                            string="Сопоставление"
                            name="page_matching"
                            groups="object_request.group_supply_manager"
                        >
                            <group string="Сопоставление номенклатуры">
                                <group>
                                    <button
                                        name="action_rematch_lines"
                                        string="Пересопоставить несопоставленные"
                                        type="object"
                                        class="btn-secondary"
                                        invisible="state in ('closed', 'cancelled')"
                                        title="Повторно запустить автосопоставление по несопоставленным строкам"
                                    />
                                    <button
                                        name="action_rematch_all_lines"
                                        string="Пересопоставить все строки"
                                        type="object"
                                        class="btn-secondary"
                                        invisible="state in ('closed', 'cancelled')"
                                        confirm="Пересмотреть все строки документа? Автоматические старые совпадения могут быть изменены или очищены."
                                        title="Повторно запустить автосопоставление по всем строкам документа"
                                    />
                                    <button
                                        name="action_rematch_with_stock_context"
                                        string="Переподобрать с учётом остатков"
                                        type="object"
                                        class="btn-secondary"
                                        invisible="state in ('closed', 'cancelled')"
                                        confirm="Переподобрать строки с учётом остатков на складах выдачи? Уверенные складские совпадения будут записаны в строки."
                                        title="Повторно подобрать товары с приоритетом складских остатков"
                                    />
                                </group>
                                <group>
                                    <button
                                        name="action_prepare_ai_candidates"
                                        string="Подобрать AI-кандидатов"
                                        type="object"
                                        class="btn-secondary"
                                        invisible="state in ('closed', 'cancelled')"
                                        title="Подобрать shortlist кандидатов без записи товара в строки"
                                    />
                                    <button
                                        name="action_apply_confident_ai_matches"
                                        string="Применить уверенные AI-сопоставления"
                                        type="object"
                                        class="btn-secondary"
                                        invisible="state in ('closed', 'cancelled')"
                                        confirm="Применить уверенные AI-сопоставления? Это массово запишет товары в строки с уверенностью не ниже 0.90."
                                        title="Массово записать товар только для строк с высокой уверенностью"
                                    />
                                </group>
                            </group>
                        </page>

                        <page
                            string="Размещение по складам"
                            name="page_stock_distribution"
                            groups="object_request.group_supply_manager,object_request.group_storekeeper"
                        >
                            <group
                                string="Настройки выдачи"
                                groups="object_request.group_supply_manager"
                            >
                                <group>
                                    <field
                                        name="stock_distribution_filter_warehouse_id"
                                        readonly="state in ('closed', 'cancelled')"
                                        options="{'no_create': True, 'no_open': True}"
                                    />
                                    <field
                                        name="stock_distribution_show_zero"
                                        widget="boolean_toggle"
                                        readonly="state in ('closed', 'cancelled')"
                                    />
                                </group>
                                <field
                                    name="issue_warehouse_ids"
                                    widget="many2many_checkboxes"
                                    readonly="state in ('closed', 'cancelled')"
                                    options="{'no_create': True}"
                                />
                            </group>
                            <field name="company_id" invisible="1"/>
                            <field
                                name="stock_distribution_refresh_key"
                                invisible="1"
                            />
                            <field
                                name="line_stock_ids"
                                readonly="state in ('closed', 'cancelled')"
                                groups="object_request.group_supply_manager"
                            >
                                <list editable="bottom">
                                    <field name="line_id" string="Строка" readonly="1"/>
                                    <field name="warehouse_id" readonly="1"/>
                                    <field name="qty_on_hand" readonly="1"/>
                                    <field name="qty_to_issue"/>
                                    <field name="qty_reserved" readonly="1"/>
                                    <field name="last_check_date" readonly="1"/>
                                    <field name="picking_id" readonly="1"/>
                                </list>
                            </field>
                            <field
                                name="line_stock_ids"
                                readonly="1"
                                groups="object_request.group_storekeeper"
                            >
                                <list>
                                    <field name="line_id" string="Строка" readonly="1"/>
                                    <field name="warehouse_id" readonly="1"/>
                                    <field name="qty_on_hand" readonly="1"/>
                                    <field name="qty_to_issue" readonly="1"/>
                                    <field name="qty_reserved" readonly="1"/>
                                    <field name="last_check_date" readonly="1"/>
                                    <field name="picking_id" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- Вкладка: Связанные документы -->
                        <page string="Связанные документы" name="page_related">
                            <group string="Выдачи со склада">
                                <field name="issue_picking_ids" nolabel="1">
                                    <list>
                                        <field name="name" string="Номер"/>
                                        <field name="state" string="Статус" widget="badge"/>
                                        <field name="scheduled_date" string="Дата"/>
                                        <field name="partner_id" string="Контрагент" optional="hide"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Закупки">
                                <field name="purchase_order_ids" nolabel="1">
                                    <list>
                                        <field name="name" string="Номер"/>
                                        <field name="state" string="Статус" widget="badge"/>
                                        <field name="date_order" string="Дата"/>
                                        <field name="partner_id" string="Поставщик"/>
                                        <field name="amount_total" string="Сумма"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <!-- Вкладка: Импорт -->
                        <page string="Импорт" name="page_import"
                            invisible="not source_file_name">
                            <group>
                                <field name="source_file_name" readonly="1"/>
                                <field name="source_file_checksum" readonly="1"/>
                                <field name="imported_at" readonly="1"/>
                                <field name="imported_by_user_id" readonly="1"/>
                            </group>
                        </page>

                    </notebook>

                </sheet>

                <!-- CHATTER -->
                <chatter/>

            </form>
        </field>
    </record>

    <!-- ================================================================
         ACTION ПРИВЯЗКИ (view_id в action)
         ================================================================ -->
    <record id="action_object_request" model="ir.actions.act_window">
        <field name="name">Требования на комплектацию</field>
        <field name="res_model">object.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_object_request_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Создайте первое требование на комплектацию объекта
            </p>
            <p>
                Требование создаётся прорабом вручную или через импорт Excel.
            </p>
        </field>
    </record>

</odoo>
