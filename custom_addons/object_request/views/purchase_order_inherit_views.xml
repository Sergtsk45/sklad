<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_inherit_object_request" model="ir.ui.view">
        <field name="name">purchase.order.inherit.object.request</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    type="object"
                    name="action_open_object_requests"
                    invisible="not is_object_request_purchase or object_request_count == 0"
                >
                    <field
                        name="object_request_count"
                        widget="statinfo"
                        string="Требования"
                    />
                </button>
                <field name="is_object_request_purchase" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
