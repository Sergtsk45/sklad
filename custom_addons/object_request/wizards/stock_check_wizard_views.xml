<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_check_wizard_form" model="ir.ui.view">
        <field name="name">object.request.stock.check.wizard.form</field>
        <field name="model">object.request.stock.check.wizard</field>
        <field name="arch" type="xml">
            <form string="Проверка актуальности требования">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Внимание!</strong>
                        Часть позиций уже есть на складе объекта. Проверьте актуальность
                        требования — возможно, некоторые позиции уже не нужны.
                        После нажатия «Проверено» вы можете скорректировать строки
                        или передать требование в работу.
                    </div>
                    <group>
                        <field name="warehouse_names" string="Проверено по складу" readonly="1"/>
                        <field name="lines_with_stock_count" string="Позиций с наличием" readonly="1"/>
                        <field name="lines_total_count" string="Всего позиций" readonly="1"/>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="name_raw" string="Наименование (файл)"/>
                            <field name="product_id" string="Товар"/>
                            <field name="qty_requested" string="Запрошено"/>
                            <field name="stock_qty_on_hand" string="На складе объекта"
                                decoration-success="stock_qty_on_hand >= qty_requested"
                                decoration-warning="stock_qty_on_hand &gt; 0 and stock_qty_on_hand &lt; qty_requested"
                            />
                            <field name="stock_breakdown" string="Склады"/>
                            <field name="uom_id" string="Ед. изм."/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button
                        name="action_confirm"
                        string="Проверено"
                        type="object"
                        class="btn-primary"
                        title="Подтверждаю, что ознакомился с наличием. Продолжу редактировать или передам в работу."
                    />
                    <button
                        name="action_recheck"
                        string="Закрыть"
                        type="object"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
