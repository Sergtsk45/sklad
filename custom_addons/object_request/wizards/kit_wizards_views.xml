<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_object_request_kit_save_wizard_form" model="ir.ui.view">
        <field name="name">object.request.kit.save.wizard.form</field>
        <field name="model">object.request.kit.save.wizard</field>
        <field name="arch" type="xml">
            <form string="Сохранить в шаблон узла">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="mode" widget="radio"/>
                    <field name="kit_name" invisible="mode != 'new'" required="mode == 'new'"/>
                    <field name="kit_id" invisible="mode != 'variant'" required="mode == 'variant'"/>
                    <field name="size"/>
                </group>
                <p class="text-muted" invisible="mode != 'variant'">
                    Строки сопоставляются с шаблоном по номеру строки (№).
                    Сохраняется только то, что отличается от строк по умолчанию.
                </p>
                <footer>
                    <button name="action_save" string="Сохранить" type="object" class="btn-primary"/>
                    <button string="Отмена" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_object_request_kit_create_wizard_form" model="ir.ui.view">
        <field name="name">object.request.kit.create.wizard.form</field>
        <field name="model">object.request.kit.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Требование из шаблона узла">
                <group>
                    <group>
                        <field name="kit_id"/>
                        <field name="known_sizes"/>
                        <field name="size"/>
                        <field name="multiplier"/>
                    </group>
                    <group>
                        <field name="project_id"/>
                        <field name="need_date"/>
                        <field name="foreman_user_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create" string="Создать требование" type="object" class="btn-primary"/>
                    <button string="Отмена" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_object_request_kit_create_wizard" model="ir.actions.act_window">
        <field name="name">Требование из шаблона узла</field>
        <field name="res_model">object.request.kit.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
