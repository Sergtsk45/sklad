<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_object_request_confirm_wizard_form" model="ir.ui.view">
        <field name="name">object.request.confirm.wizard.form</field>
        <field name="model">object.request.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Подтверждение">
                <field name="request_id" invisible="1"/>
                <field name="action_type" invisible="1"/>
                <group>
                    <field name="message" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Продолжить"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Отмена"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>
