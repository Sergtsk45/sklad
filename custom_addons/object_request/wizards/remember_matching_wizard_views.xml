<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_remember_matching_wizard_form" model="ir.ui.view">
        <field name="name">object.request.remember.matching.wizard.form</field>
        <field name="model">object.request.remember.matching.wizard</field>
        <field name="arch" type="xml">
            <form string="Подтвердить сопоставление">
                <sheet>
                    <group>
                        <field name="message" nolabel="1" readonly="1"/>
                        <field name="line_ids" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_confirm"
                        string="Запомнить всё равно"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Отмена"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
