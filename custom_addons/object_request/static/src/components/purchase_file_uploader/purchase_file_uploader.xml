<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Локализация «Upload Bill» (upstream: purchase/static/src/components/purchase_file_uploader/).
         При обновлении Odoo проверить шаблон purchase.DocumentFileUploader. -->
    <t t-inherit="purchase.DocumentFileUploader" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('btn', 'btn-secondary')]" position="replace">
            <button type="button" class="btn btn-secondary" data-hotkey="shift+i">
                Загрузить счёт
            </button>
        </xpath>
    </t>
</templates>
