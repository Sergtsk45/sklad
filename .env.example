## @file: .env.example
## @description: Шаблон переменных окружения для локального запуска Odoo 19 в Docker Compose
## @dependencies: docker-compose.local.yml, config/odoo.local.conf
## @created: 2026-03-15

# Postgres (локальная dev БД)
POSTGRES_DB=odoo19_local
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_local_password_change_me

# Odoo master password (для Database Manager / бэкапов из UI)
ODOO_ADMIN_PASSWD=odoo_master_password_change_me

# Timezone (опционально)
TZ=Europe/Moscow

